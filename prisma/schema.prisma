generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum WorkPackageType {
  TASK
  MILESTONE
  RISK
  PHASE
}

enum Priority {
  P0
  P1
  P2
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum Difficulty {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  ARCHIVED
}

enum PlatformRole {
  ADMIN
  PROJECT_MANAGER
  PARTICIPANT
}

enum WorkPackageOrigin {
  SELF
  AI_SELF
  MANAGER
  IM_IMPORT
}

enum WorkPackageCommentType {
  COMMENT
  DECISION
  BLOCKER
  EVIDENCE
}

enum WorkPackageCommentSource {
  PLATFORM
  FEISHU
  WECOM_BOT
  DINGTALK
  SLACK
  EMAIL
  GENERIC
}

enum WorkPackageApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum NotificationChannelType {
  FEISHU
  WECOM_BOT
  DINGTALK
  SLACK
  EMAIL
  GENERIC
}

enum NotificationDeliveryStatus {
  PREVIEW
  SENT
  SKIPPED
  FAILED
}

enum NotificationReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AgentBreakdownDraftStatus {
  PENDING
  CONFIRMED
  DISCARDED
}

enum FeishuAuthAuditEvent {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  PROFILE_COMPLETED
  BINDING_REMOVED
}

model Person {
  id           String                @id @default(cuid())
  name         String
  role         String
  capacity     Int
  skills       String                @default("[]")
  workPackages WorkPackage[]         @relation("AssignedWorkPackages")
  users        User[]
  comments     WorkPackageComment[]
  approvals    WorkPackageApproval[]
}

model Project {
  id                   String                @id @default(cuid())
  identifier           String                @unique
  name                 String
  description          String?
  parentId             String?
  parent               Project?              @relation("ProjectHierarchy", fields: [parentId], references: [id])
  children             Project[]             @relation("ProjectHierarchy")
  status               ProjectStatus         @default(ACTIVE)
  health               RiskLevel             @default(MEDIUM)
  initialDifficulty    Difficulty            @default(MEDIUM)
  difficultyOverride   Difficulty?
  progress             Int                   @default(0)
  startDate            DateTime?
  endDate              DateTime?
  enabledModules       String                @default("[]")
  workPackages         WorkPackage[]
  memberships          ProjectMembership[]
  stewardMessages      StewardMessage[]
  notificationRules    NotificationRule[]
  agentBreakdownDrafts AgentBreakdownDraft[]
  qualitySnapshots     ProjectQualitySnapshot[]
  qualityMetrics       ProjectQualityMetric[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([parentId])
}

model User {
  id                   String                @id @default(cuid())
  name                 String
  role                 PlatformRole
  personId             String
  person               Person                @relation(fields: [personId], references: [id])
  feishuBinding        FeishuAccountBinding?
  feishuAuthAuditLogs  FeishuAuthAuditLog[]
  memberships          ProjectMembership[]
  agentBreakdownDrafts AgentBreakdownDraft[]
  agentApiKeys         AgentApiKey[]
  agentInvocations     AgentToolInvocation[] @relation("CallerUserInvocations")
  createdWorkPackages  WorkPackage[]         @relation("CreatedWorkPackages")
  notifications        UserNotification[]
  createdNotificationReviews NotificationReviewRequest[] @relation("NotificationReviewRequester")
  assignedNotificationReviews NotificationReviewRequest[] @relation("NotificationReviewReviewer")
  receivedNotificationReviewResults NotificationReviewRequest[] @relation("NotificationReviewReviewed")
  createdAt            DateTime              @default(now())
}

model FeishuAccountBinding {
  id           String   @id @default(cuid())
  userId       String   @unique
  tenantKey    String   @default("default")
  openId       String
  unionId      String?
  avatarUrl    String?
  displayName  String
  email        String?
  mobile       String?
  profileCompletedAt DateTime?
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLoginAt  DateTime?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantKey, openId])
}

model FeishuAuthAuditLog {
  id          String               @id @default(cuid())
  userId      String?
  tenantKey   String               @default("default")
  openId      String?
  unionId     String?
  event       FeishuAuthAuditEvent
  success     Boolean              @default(true)
  message     String?
  redirectTo  String?
  createdAt   DateTime             @default(now())
  user        User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([event, createdAt])
}

model FeishuDepartmentTreeSnapshot {
  id             String   @id @default(cuid())
  tenantKey      String   @unique @default("default")
  treeJson       String   @default("[]")
  departmentOptionsJson String @default("[]")
  excludedDepartmentIdsJson String @default("[]")
  departmentCount Int     @default(0)
  userCount      Int      @default(0)
  syncedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ProjectMembership {
  id        String  @id @default(cuid())
  userId    String
  projectId String
  isLead    Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model WorkPackage {
  id               Int                   @id @default(autoincrement())
  projectId        String?
  type             WorkPackageType       @default(TASK)
  subject          String
  description      String                @default("")
  status           String                @default("todo")
  priority         Priority              @default(P1)
  difficulty       Difficulty            @default(MEDIUM)
  origin           WorkPackageOrigin     @default(MANAGER)
  createdByUserId  String
  assigneeId       String?
  parentId         Int?
  parent           WorkPackage?          @relation("WorkPackageHierarchy", fields: [parentId], references: [id])
  children         WorkPackage[]         @relation("WorkPackageHierarchy")
  startDate        DateTime?
  dueDate          DateTime?
  estimateHours    Int?
  percentComplete  Int                   @default(0)
  lastProgressNote String                @default("")
  blockedReason    String?
  blockedStartedAt DateTime?
  blockedResolvedAt DateTime?
  delayReason      String?
  delayDays        Int                   @default(0)
  delayStartedAt   DateTime?
  delayResolvedAt  DateTime?
  progressUpdatedByUserId String?
  completedAt      DateTime?
  dependencies     String                @default("[]")
  requiredSkills   String                @default("[]")
  isOnCriticalPath Boolean               @default(false)
  riskLevel        RiskLevel?
  riskImpact       String?
  riskMitigation   String?
  project          Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy        User                  @relation("CreatedWorkPackages", fields: [createdByUserId], references: [id])
  assignee         Person?               @relation("AssignedWorkPackages", fields: [assigneeId], references: [id])
  comments         WorkPackageComment[]
  approvals        WorkPackageApproval[]
  progressEvents   WorkPackageProgressEvent[]
  impactSources    WorkPackageImpactEvent[] @relation("ImpactSource")
  impactTargets    WorkPackageImpactEvent[] @relation("ImpactTarget")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([projectId, type])
  @@index([projectId, status])
  @@index([createdByUserId])
  @@index([assigneeId])
  @@index([parentId])
}

model WorkPackageComment {
  id                String                   @id @default(cuid())
  workPackageId     Int
  authorPersonId    String
  body              String
  type              WorkPackageCommentType
  mentionsPersonIds String                   @default("[]")
  source            WorkPackageCommentSource @default(PLATFORM)
  sourceChannelId   String?
  externalMessageId String?
  externalThreadId  String?
  authorDisplayName String?
  workPackage       WorkPackage              @relation(fields: [workPackageId], references: [id], onDelete: Cascade)
  author            Person                   @relation(fields: [authorPersonId], references: [id])
  createdAt         DateTime                 @default(now())

  @@unique([source, externalMessageId])
  @@index([workPackageId, createdAt])
}

model WorkPackageApproval {
  id               String                    @id @default(cuid())
  workPackageId    Int
  reviewerPersonId String
  status           WorkPackageApprovalStatus
  comment          String
  workPackage      WorkPackage               @relation(fields: [workPackageId], references: [id], onDelete: Cascade)
  reviewer         Person                    @relation(fields: [reviewerPersonId], references: [id])
  createdAt        DateTime                  @default(now())

  @@index([workPackageId, createdAt])
}

model WorkPackageProgressEvent {
  id            String                       @id @default(cuid())
  workPackageId Int
  projectId     String?
  phaseRef      String?
  nodeRef       String?
  personId      String?
  userId        String?
  eventType     WorkPackageProgressEventType
  reason        String?
  previousJson  String                       @default("{}")
  nextJson      String                       @default("{}")
  occurredAt    DateTime                     @default(now())
  workPackage   WorkPackage                  @relation(fields: [workPackageId], references: [id], onDelete: Cascade)

  @@index([workPackageId, occurredAt])
  @@index([projectId, occurredAt])
  @@index([personId, eventType])
  @@index([eventType, occurredAt])
}

model WorkPackageImpactEvent {
  id                    String      @id @default(cuid())
  projectId             String?
  sourceWorkPackageId   Int
  impactedWorkPackageId Int
  dependencyPathJson    String      @default("[]")
  delayDays             Int         @default(0)
  reason                String?
  resolvedAt            DateTime?
  createdAt             DateTime    @default(now())
  sourceWorkPackage     WorkPackage @relation("ImpactSource", fields: [sourceWorkPackageId], references: [id], onDelete: Cascade)
  impactedWorkPackage   WorkPackage @relation("ImpactTarget", fields: [impactedWorkPackageId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([sourceWorkPackageId])
  @@index([impactedWorkPackageId])
  @@index([resolvedAt])
}

model StewardMessage {
  id        String    @id @default(cuid())
  projectId String?
  type      String
  title     String
  body      String
  level     RiskLevel
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}

model NotificationChannel {
  id                String                    @id @default(cuid())
  name              String
  type              NotificationChannelType
  target            String
  enabled           Boolean                   @default(true)
  audienceRoles     String                    @default("[]")
  audiencePersonIds String                    @default("[]")
  secret            String?
  note              String?
  rules             NotificationRuleChannel[]
  deliveries        NotificationDelivery[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
}

model NotificationRule {
  id            String                    @id @default(cuid())
  projectId     String?
  name          String
  eventTypes    String                    @default("[]")
  minLevel      RiskLevel
  audienceRoles String                    @default("[]")
  project       Project?                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channels      NotificationRuleChannel[]
  deliveries    NotificationDelivery[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
}

model NotificationRuleChannel {
  ruleId    String
  channelId String
  rule      NotificationRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  channel   NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([ruleId, channelId])
}

model NotificationDelivery {
  id             String                     @id @default(cuid())
  channelId      String
  ruleId         String
  notificationId String
  status         NotificationDeliveryStatus
  preview        String
  payloadJson    String                     @default("{}")
  audienceRoles  String                     @default("[]")
  channel        NotificationChannel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  rule           NotificationRule           @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  createdAt      DateTime                   @default(now())
}

model UserNotification {
  id              String    @id @default(cuid())
  recipientUserId String
  title           String
  body            String
  level           RiskLevel @default(MEDIUM)
  source          String    @default("system")
  link            String?
  payloadJson     String    @default("{}")
  readAt          DateTime?
  unreadReminderSentAt DateTime?
  createdAt       DateTime  @default(now())
  recipient       User      @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, createdAt])
}

model NotificationReviewRequest {
  id              String                   @id @default(cuid())
  requesterUserId String
  reviewerUserId  String
  reviewedUserId  String
  title           String
  body            String
  link            String?
  payloadJson     String                   @default("{}")
  status          NotificationReviewStatus @default(PENDING)
  resultComment   String?
  reviewedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  requester       User                     @relation("NotificationReviewRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  reviewer        User                     @relation("NotificationReviewReviewer", fields: [reviewerUserId], references: [id], onDelete: Cascade)
  reviewedUser    User                     @relation("NotificationReviewReviewed", fields: [reviewedUserId], references: [id], onDelete: Cascade)

  @@index([reviewerUserId, status, createdAt])
  @@index([reviewedUserId, createdAt])
}

model PlatformFeatureFlag {
  key           String   @id
  siteEnabled   Boolean  @default(true)
  roleOverrides String   @default("{}")
  description   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AgentApiKey {
  id             String                @id @default(cuid())
  name           String
  keyPrefix      String                @unique
  hashedKey      String
  allowedTools   String                @default("[]")
  allowedRoles   String                @default("[]")
  qpsLimit       Int                   @default(5)
  dailyLimit     Int                   @default(1000)
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdByUserId String
  createdBy      User                  @relation(fields: [createdByUserId], references: [id])
  invocations    AgentToolInvocation[]
  createdAt      DateTime              @default(now())
}

model AgentToolInvocation {
  id                 String       @id @default(cuid())
  toolName           String
  callerUserId       String?
  callerApiKeyId     String?
  source             String       @default("rest")
  inputJson          String       @default("{}")
  outputJson         String       @default("{}")
  status             String
  errorMessage       String?
  idempotencyKey     String?
  parentInvocationId String?
  durationMs         Int          @default(0)
  callerUser         User?        @relation("CallerUserInvocations", fields: [callerUserId], references: [id])
  callerApiKey       AgentApiKey? @relation(fields: [callerApiKeyId], references: [id])
  createdAt          DateTime     @default(now())

  @@index([toolName, createdAt])
  @@index([callerUserId, createdAt])
  @@index([callerApiKeyId, createdAt])
  @@unique([idempotencyKey, toolName])
}

model AgentBreakdownDraft {
  id              String                    @id @default(cuid())
  projectId       String?
  createdByUserId String
  prompt          String
  analysisJson    String
  status          AgentBreakdownDraftStatus @default(PENDING)
  project         Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy       User                      @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
}

enum ScheduleScenarioStatus {
  DRAFT
  PROPOSED
  APPLIED
  DISCARDED
}

enum QualitySnapshotSource {
  BASELINE
  DRAFT
  APPLIED
}

enum WorkPackageProgressEventType {
  PROGRESS_UPDATED
  BLOCKED
  BLOCKED_RESOLVED
  DELAYED
  DELAY_RESOLVED
  RISK_CHANGED
  COMPLETED
}

enum ProjectQualitySnapshotTrigger {
  MANUAL
  TASK_PROGRESS_UPDATED
  NODE_COMPLETED
  MILESTONE_COMPLETED
  BLOCKED_CHANGED
  BLOCKED_RESOLVED
  DELAY_CHANGED
  DELAY_RESOLVED
  IMPACT_PROPAGATED
  PROJECT_COMPLETED
}

model ScheduleBaseline {
  id              String             @id @default(cuid())
  projectId       String
  version         Int
  snapshotJson    String
  appliedByUserId String?
  appliedAt       DateTime           @default(now())
  scenarios       ScheduleScenario[]
  createdAt       DateTime           @default(now())

  @@unique([projectId, version])
  @@index([projectId, appliedAt])
}

model ScheduleScenario {
  id              String                 @id @default(cuid())
  projectId       String
  baselineId      String?
  name            String
  status          ScheduleScenarioStatus @default(DRAFT)
  draftJson       String
  agentSummary    String?
  createdByUserId String
  appliedAt       DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  baseline        ScheduleBaseline?      @relation(fields: [baselineId], references: [id], onDelete: SetNull)
  changes         ScheduleChange[]

  @@index([projectId, status])
  @@index([projectId, updatedAt])
}

model ScheduleChange {
  id          String           @id @default(cuid())
  scenarioId  String
  changeType  String
  targetRef   String
  payloadJson String           @default("{}")
  createdAt   DateTime         @default(now())
  scenario    ScheduleScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([scenarioId, createdAt])
}

model ProjectQualitySnapshot {
  id                String                 @id @default(cuid())
  projectId         String
  source            QualitySnapshotSource
  triggerType       ProjectQualitySnapshotTrigger @default(MANUAL)
  scenarioId        String?
  baselineId        String?
  projectProgress   Int
  projectDifficulty Difficulty
  startDate         DateTime?
  endDate           DateTime?
  phaseCount        Int
  nodeCount         Int
  taskItemCount     Int
  metricJson        String                 @default("{}")
  aiContextJson     String                 @default("{}")
  createdByUserId   String?
  createdAt         DateTime               @default(now())
  project           Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  metrics           ProjectQualityMetric[]

  @@index([projectId, createdAt])
  @@index([projectId, source, createdAt])
  @@index([scenarioId])
  @@index([baselineId])
}

model ProjectQualityMetric {
  id              String                 @id @default(cuid())
  snapshotId      String
  projectId       String
  entityType      String
  entityRef       String
  metricKey       String
  numericValue    Float?
  textValue       String?
  difficultyValue Difficulty?
  startDate       DateTime?
  endDate         DateTime?
  personId        String?
  teamRef         String?
  evidenceJson    String                 @default("{}")
  createdAt       DateTime               @default(now())
  snapshot        ProjectQualitySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  project         Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([projectId, entityType, metricKey])
  @@index([personId, metricKey])
  @@index([teamRef, metricKey])
}
